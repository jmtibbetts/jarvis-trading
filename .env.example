# Alpaca
ALPACA_API_KEY=your_key_here
ALPACA_API_SECRET=your_secret_here
ALPACA_MODE=paper          # paper or live

# LM Studio (local LLM)
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=local-model

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# News and threat intelligence
NEWS_MAX_ARTICLES=120
NEWS_ITEMS_PER_SOURCE=8
NEWS_DEDUP_DAYS=7
NEWS_MAX_AGE_HOURS=72
NEWS_HTTP_TIMEOUT=12
NEWS_AGGREGATOR_MODE=fallback
NEWS_AGGREGATOR_FALLBACK_THRESHOLD=40
X_BEARER_TOKEN=
X_USERNAMES=realDonaldTrump,POTUS,WhiteHouse
# Use the URL/token supplied by TMTG or your licensed Truth API vendor.
TRUTH_API_URL=
TRUTH_API_TOKEN=
TRUTH_API_ACCOUNTS=realDonaldTrump,WhiteHouse

# Signal evidence and cache coverage
OHLCV_WARM_TIMEFRAMES=15m,30m,1H,2H,4H,1D
MIN_SIGNAL_DATA_QUALITY=35
MIN_SIGNAL_FRESHNESS=20

# Crypto market data (optional; public providers work keyless where allowed)
CRYPTO_DISCOVERY_LIMIT=150
CRYPTO_CACHE_LIMIT=60
CRYPTO_SCAN_LIMIT=150
CRYPTO_API_TIMEOUT=8
CRYPTO_TICKER_CACHE_SECONDS=30
ALLOW_YFINANCE_CRYPTO_FALLBACK=false
ALLOW_AGGREGATOR_SYMBOL_FALLBACKS=false
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=
CRYPTOCOMPARE_API_KEY=

# Trade management guardrails
MAX_LOSS_PER_TRADE_USD=15
PROFIT_LOCK_USD=10
MIN_DYNAMIC_TRAIL_PCT=0.75
TARGET_REWARD_MULTIPLIER=2.8
EXIT_ORDER_REPRICE_PCT=0.25
ALLOW_STANDALONE_TAKE_PROFIT=false

# App
PORT=3000
LOG_LEVEL=INFO
# Local LLM scheduling. The signal engine always uses the configured local model;
# these limits prevent overlapping jobs from stalling an entire generation cycle.
# Raising SIGNAL_LLM_WORKERS/LLM_MAX_PARALLEL only helps if LM Studio's own
# "Parallel Requests" setting is raised to match — otherwise LLM_MAX_PARALLEL's
# semaphore just serializes calls anyway, so there's no throughput gain and you
# risk request contention. Leave both at 1 unless you've confirmed your LM
# Studio build/hardware handles concurrent local inference.
LLM_MAX_PARALLEL=1
# 0 queues every batch; the wall-clock budget stops work that cannot finish in time.
# "Thinking" models (Qwen3 etc.) burn tokens reasoning before answering, so a low
# budget here causes MOST batches to fall through to the deterministic TA-only
# path even when the LLM is fully available — not because it's actually down.
SIGNAL_LLM_MAX_BATCHES=0
SIGNAL_LLM_WORKERS=1
SIGNAL_LLM_TIME_BUDGET_SECONDS=240
SIGNAL_LLM_QUEUE_TIMEOUT_SECONDS=8
SIGNAL_LLM_REQUEST_TIMEOUT_SECONDS=30

# Telegram setup alerts. Existing messages are edited only after material changes.
TELEGRAM_SETUP_LIMIT=8
TELEGRAM_ENTRY_CHANGE_PCT=0.25
TELEGRAM_LEVEL_CHANGE_PCT=0.50
TELEGRAM_POSITION_CHANGE_PCT=2.0
TELEGRAM_POSITION_CHANGE_USD=25
TELEGRAM_POSITION_MIN_PROFIT_USD=10
TELEGRAM_POSITION_MIN_LOSS_USD=10
