.env
data/
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/
*.log

# frontend/ (Vite+Svelte dashboard rebuild)
frontend/node_modules/
static/dist/
.mcp.json

# Local DB backups and vendored wheels — never belong in git
backups/
backup-*/
*.whl

# Stray root-level SQLite files. The real database lives in data/,
# which is already ignored — a database never belongs in git.
/*.db
/*.db-journal

# ML datasets: reproducible from the DB, and large. Rebuild, do not commit.
ml/datasets/*.npz
ml/models/

# Built ML datasets — 309 MB of parquet regenerated by ml/datasets
# builders. Artifacts, not source; a single `git add -A` swept them into
# a commit once and that must not be repeatable.
ml/datasets/out/

# Runtime state: pid files. Written by scripts/start_jarvis.sh, and
# meaningless on any machine other than the one that wrote them.
run/
