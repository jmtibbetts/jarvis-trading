# Alpaca
ALPACA_API_KEY=your_key_here
ALPACA_API_SECRET=your_secret_here
ALPACA_MODE=paper          # paper or live

# LM Studio (local LLM)
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=local-model

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# News and threat intelligence
NEWS_MAX_ARTICLES=120
NEWS_ITEMS_PER_SOURCE=8
NEWS_DEDUP_DAYS=7
NEWS_MAX_AGE_HOURS=72
NEWS_HTTP_TIMEOUT=12
NEWS_AGGREGATOR_MODE=fallback
NEWS_AGGREGATOR_FALLBACK_THRESHOLD=40
X_BEARER_TOKEN=
X_USERNAMES=realDonaldTrump,POTUS,WhiteHouse
# Use the URL/token supplied by TMTG or your licensed Truth API vendor.
TRUTH_API_URL=
TRUTH_API_TOKEN=
TRUTH_API_ACCOUNTS=realDonaldTrump,WhiteHouse

# SEC EDGAR insider-transaction intelligence (free, no API key — but SEC's
# Fair Access policy requires a real identifying User-Agent or it 403s).
# Format: "Your Company/App you@example.com"
SEC_EDGAR_USER_AGENT=

# FRED (St. Louis Fed) macro data — free, instant signup:
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Weekly petroleum and natural-gas storage (free at eia.gov/opendata).
# EXACT SPELLING MATTERS. The operator's own file carried EIA_APi_KEY —
# lowercase i — and lib/official_data.py reads EIA_API_KEY, so EIA was
# configured and permanently invisible: it reported "EIA_API_KEY not set"
# forever and no energy fundamentals ever loaded. The variable was absent
# from this file, so there was no canonical spelling to copy from.
EIA_API_KEY=

# OpenFIGI (openfigi.com) — maps the CUSIPs in SEC Form 13F filings to tickers.
# CUSIP-to-ticker is a licensed dataset, so this is the free path to it.
# Optional: without a key the API still works but is capped at 10 identifiers
# per request, which makes 13F coverage build very slowly. A free key raises
# that to 100 per request (a 10x speedup) — get one at openfigi.com/api.
OPENFIGI_API_KEY=

# MCP servers (same ones configured in LM Studio — Jarvis connects to them
# DIRECTLY, since LM Studio's MCP config only applies to its own chat UI,
# never to API callers). Exa and Firecrawl work keyless with usage limits;
# Massive and Tavily return 401 until their keys are set. Keys are sent as
# Authorization: Bearer headers.
MASSIVE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=

# Crypto L2 order book streams (free public WebSocket feeds, no key).
# Binance.com blocks US IPs (HTTP 451) — defaults to Binance.US. Override to
# stream.binance.com:9443 only if you know your deployment isn't US-based.
BINANCE_WS_HOST=stream.binance.us:9443

# Signal evidence and cache coverage
OHLCV_WARM_TIMEFRAMES=15m,30m,1H,2H,4H,1D
MIN_SIGNAL_DATA_QUALITY=35
MIN_SIGNAL_FRESHNESS=20

# Crypto market data (optional; public providers work keyless where allowed)
CRYPTO_DISCOVERY_LIMIT=150
CRYPTO_CACHE_LIMIT=60
CRYPTO_SCAN_LIMIT=150
CRYPTO_API_TIMEOUT=8
CRYPTO_TICKER_CACHE_SECONDS=30
ALLOW_YFINANCE_CRYPTO_FALLBACK=false
ALLOW_AGGREGATOR_SYMBOL_FALLBACKS=false
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=
CRYPTOCOMPARE_API_KEY=

# Solana wallet activity (Helius). JARVIS POLLS this — it never listens.
# An earlier design put an internet-facing mailbox VM in front of Helius
# webhooks; polling reaches the same data with no exposed host at all, so
# the receiver was dropped rather than hardened.
#
# HELIUS_BASE only needs setting for a non-default region/plan.
HELIUS_API_KEY=

# THE WALLET UNIVERSE IS THE DATABASE, NOT THIS FILE.
#
# `wallet_registry` is the source of truth. Discovery finds wallets,
# scoring measures them, and the lifecycle engine promotes or demotes them.
# Every runtime consumer — the activity collector, /wallet/intel, scoring,
# the UI — reads that one population.
#
# HELIUS_WATCH_WALLETS is SEED INPUT ONLY. Its addresses are imported into
# the registry at startup as PINNED CANDIDATES: pinned because an operator
# chose them, candidates because choosing a wallet is a reason to
# investigate it and not evidence that it is any good. Leaving it EMPTY is
# the normal configuration — the desk discovers its own wallets.
#
# (This previously read "empty means the collector stays inert", which was
# true of an architecture where an environment variable was the database.)
HELIUS_WATCH_WALLETS=

# Feature switches. Intelligence covers scoring and /wallet/intel;
# discovery covers the autonomous search that populates the registry.
HELIUS_WALLET_INTELLIGENCE_ENABLED=true
HELIUS_WALLET_DISCOVERY_ENABLED=true

# ── Automatic wallet polling ─────────────────────────────────────────────
# Runs lib/wallet_activity.collect_once() on a timer. READ-ONLY: it places
# no order, moves no cash and signs nothing.
#
# INDEPENDENT OF JARVIS_DISABLE_SCHEDULER, on purpose. The legacy scheduler
# that used to own this job also executes signals and manages the book, so
# turning wallet intelligence on used to mean turning all of that on too.
#
# OFF unless set to an explicit true token (1/true/yes/on/enabled). Absent,
# empty or misspelled leaves it off — note that bool("false") is True, which
# is why this is an allowlist rather than a truthiness check.
JARVIS_HELIUS_WALLET_POLLING_ENABLED=false

# Seconds between passes. Default 900 — the cadence the legacy scheduler
# already used for this job, which is what its pagination, pacing and
# backfill budgets were sized against. Clamped to [60, 86400]; a malformed
# value falls back to the default. Cost is bounded by the limits below, not
# by this: 5 wallets x HELIUS_MAX_PAGES_PER_POLL is at most 25 calls a pass.
JARVIS_HELIUS_WALLET_POLL_INTERVAL_SECONDS=900

# Bounds the ANALYSIS QUEUE — wallets in DISCOVERED/CANDIDATE/ANALYZING —
# not the size of the registry. The registry is meant to accumulate learned
# identities permanently, and capping that would eventually switch
# discovery off for the crime of having worked.
HELIUS_DISCOVERY_MAX_CANDIDATES=5000

# Per-address transfers per poll.
# PER-REQUEST page size. The Transfers API serves at most 100 per page, so
# this is clamped to 100 — a larger value is not a larger page, it is a
# request the server refuses while the caller believes it succeeded.
HELIUS_PAGE_LIMIT=100
# TOTAL transfer records per wallet per poll — a budget, not a page size.
# Depth comes from following the cursor across pages, not from asking for
# a bigger one. This previously advertised 500 while the collector fetched
# a single page and stopped.
HELIUS_BACKFILL_LIMIT=500
# Hard ceiling on pages per wallet per poll, so one pathological address
# cannot consume the whole Helius budget. When a bound stops collection
# early the pass reports truncated_due_budget and names which bound.
HELIUS_MAX_PAGES_PER_POLL=5
# Client pacing and retry policy. All Helius traffic goes through
# lib/helius_client — header auth, one rate limiter, one metrics surface.
HELIUS_MIN_CALL_SPACING=0.05
HELIUS_MAX_RETRIES=3

# ── Token surge ──────────────────────────────────────────────────────────
# One engine (lib/token_surge) persists a snapshot per pool per scan and
# scores acceleration against each token's OWN stored history. Discovery
# and the UI consume the same result.
TOKEN_SURGE_DISCOVERY_ENABLED=true
TOKEN_SURGE_MIN_LIQUIDITY_USD=25000
TOKEN_SURGE_MIN_VOLUME_USD=5000
TOKEN_SURGE_MIN_SCORE=70
TOKEN_SURGE_EXTREME_SCORE=90

# Trade management guardrails
MAX_LOSS_PER_TRADE_USD=15
PROFIT_LOCK_USD=10
MIN_DYNAMIC_TRAIL_PCT=0.75
TARGET_REWARD_MULTIPLIER=2.8
EXIT_ORDER_REPRICE_PCT=0.25
ALLOW_STANDALONE_TAKE_PROFIT=false

# App
PORT=3000
LOG_LEVEL=INFO
# Local LLM scheduling. The signal engine always uses the configured local
# model; these limits stop overlapping jobs from stalling a generation cycle.
#
# 4 IS THE SUPPORTED PROFILE, AND IT IS WRITTEN DOWN HERE ON PURPOSE.
# This file shipped 1, lib/lmstudio.py defaulted to 1, and the module
# docstring claimed "4-slot parallel semaphore ... matching LM Studio's
# 4-slot config". Three statements, two of them wrong. The desk measured a
# genuine peak of 4 in flight only because the operator's own .env supplied
# it — so a load-bearing runtime property depended on an undocumented local
# value, and any fresh install silently serialised every call.
#
# This must MATCH LM Studio's own "Parallel Requests" setting. Raising it
# past what LM Studio serves buys nothing and adds contention; lowering it
# below serialises work the GPU could have overlapped.
LLM_MAX_PARALLEL=4
# 0 queues every batch; the wall-clock budget stops work that cannot finish in time.
# "Thinking" models (Qwen3 etc.) burn tokens reasoning before answering, so a low
# budget here causes MOST batches to fall through to the deterministic TA-only
# path even when the LLM is fully available — not because it's actually down.
SIGNAL_LLM_MAX_BATCHES=0
SIGNAL_LLM_WORKERS=1
SIGNAL_LLM_TIME_BUDGET_SECONDS=240
SIGNAL_LLM_QUEUE_TIMEOUT_SECONDS=8
SIGNAL_LLM_REQUEST_TIMEOUT_SECONDS=30

# Telegram setup alerts. Existing messages are edited only after material changes.
TELEGRAM_SETUP_LIMIT=8
TELEGRAM_ENTRY_CHANGE_PCT=0.25
TELEGRAM_LEVEL_CHANGE_PCT=0.50
TELEGRAM_POSITION_CHANGE_PCT=2.0
TELEGRAM_POSITION_CHANGE_USD=25
TELEGRAM_POSITION_MIN_PROFIT_USD=10
TELEGRAM_POSITION_MIN_LOSS_USD=10

# How often the cheap surge sampler runs. It is the ONLY writer of
# TokenActivitySnapshot / TokenSurgeState — the GET route is read-only, so
# how often someone refreshes a dashboard never changes what the detector
# measures. GeckoTerminal only, no Helius, which is what makes it affordable
# to run often and lets the expensive Helius escalation stay selective.
TOKEN_SURGE_SCAN_INTERVAL_SECONDS=120

# ── Platform execution mode ──────────────────────────────────────────────
# What JARVIS is permitted to do with REAL money. JARVIS is currently a
# virtual training laboratory, so the default — and the fail-closed answer
# for any unrecognised value — is VIRTUAL_ONLY.
#
#   VIRTUAL_ONLY   no real order submission at all. Market and account data
#                  still flow; reading a broker is not trading.
#   LIVE_SHADOW    real orders still refused; live-adjacent paths may run
#                  so their behaviour can be observed.
#   LIVE_LIMITED   real submission permitted within explicit caps.
#   LIVE_ENABLED   real submission permitted.
#
# Deliberate asymmetry: OPENING exposure is gated, CLOSING it never is. A
# mode switch must not be able to strand an open real position behind a
# training-mode flag.
JARVIS_PLATFORM_MODE=VIRTUAL_ONLY

# ── EXTERNAL BROKER CONNECTOR ────────────────────────────────────────────
# OFF by default, and it should stay off.
#
# Three scheduled jobs predate the VIRTUAL_ONLY architecture: `execute`
# submits orders to Alpaca, `positions` manages Alpaca positions, and
# `guardian` reads the Alpaca ACCOUNT. None of them describes the desk's
# current autonomous execution, which is the Virtual CEX
# (jobs/paper_trading.py) and the Virtual DEX (lib/dex_autotrade.py), nor
# its current training risk, which is the aggregate of those two books.
#
# An external account may legitimately be DATA, REFERENCE or GROUND TRUTH.
# It must not silently define current training positions or execution.
# Setting this to 1 re-enables all three on their old schedules.
JARVIS_ENABLE_EXTERNAL_BROKER_CONNECTOR=0

# Autonomous virtual DEX trading. OFF by default — a desk that has not
# opted in pays nothing for the job's registration. When enabled it reads
# the SAME surge result the UI reads (one surge engine, never a second
# definition) and applies the full gate: gas, pool depth, depth-weighted
# impact, then NET expectancy after every DEX cost.
DEX_AUTOTRADE_ENABLED=false
